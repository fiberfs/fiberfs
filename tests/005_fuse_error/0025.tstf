fiber_test "cstore async crash"

# Setup cstore
cstore_init 0
config_add CSTORE_SERVER true
config_add CSTORE_SERVER_ADDRESS "127.0.0.1"
config_add CSTORE_SERVER_PORT 0
cstore_init 1
cstore_mock_s3 1 region access_key secret_key
cstore_set_s3 0 $cstore_server_host:1 $cstore_server_port:1 region access_key secret_key

# Setup crash on async delete
error_cstore_crash_async_delete

# Mount
sys_mkdir_tmp
fs_test_rw_mount $sys_tmpdir

# Modify the index, we crash on the first deletion
set file $sys_tmpdir "/crash.txt"
sys_write $file "goodbyte"

fs_test_release_all_wait
cstore_wait 0

fuse_test_unmount
